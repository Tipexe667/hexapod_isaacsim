        def PhysicsRevoluteJoint "coxa_joint_leg1" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 1.8
            float newton:damping = 0.0017453292
            float newton:friction = 0.05
            float newton:velocityLimit = 458.36624
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </hexapod_isaacsim/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </hexapod_isaacsim/Geometry/base_link/coxa_leg1>
