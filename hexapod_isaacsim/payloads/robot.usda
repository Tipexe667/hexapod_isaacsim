#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "hexapod_isaacsim"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "hexapod_isaacsim" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </hexapod_isaacsim/Physics/coxa_joint_leg1>,
        </hexapod_isaacsim/Physics/coxa_joint_leg2>,
        </hexapod_isaacsim/Physics/coxa_joint_leg3>,
        </hexapod_isaacsim/Physics/coxa_joint_leg4>,
        </hexapod_isaacsim/Physics/coxa_joint_leg5>,
        </hexapod_isaacsim/Physics/coxa_joint_leg6>,
        </hexapod_isaacsim/Physics/femur_joint_leg1>,
        </hexapod_isaacsim/Physics/tibia_joint_leg1>,
        </hexapod_isaacsim/Physics/foot_joint_leg1>,
        </hexapod_isaacsim/Physics/femur_joint_leg2>,
        </hexapod_isaacsim/Physics/tibia_joint_leg2>,
        </hexapod_isaacsim/Physics/foot_joint_leg2>,
        </hexapod_isaacsim/Physics/femur_joint_leg3>,
        </hexapod_isaacsim/Physics/tibia_joint_leg3>,
        </hexapod_isaacsim/Physics/foot_joint_leg3>,
        </hexapod_isaacsim/Physics/femur_joint_leg4>,
        </hexapod_isaacsim/Physics/tibia_joint_leg4>,
        </hexapod_isaacsim/Physics/foot_joint_leg4>,
        </hexapod_isaacsim/Physics/femur_joint_leg5>,
        </hexapod_isaacsim/Physics/tibia_joint_leg5>,
        </hexapod_isaacsim/Physics/foot_joint_leg5>,
        </hexapod_isaacsim/Physics/femur_joint_leg6>,
        </hexapod_isaacsim/Physics/tibia_joint_leg6>,
        </hexapod_isaacsim/Physics/foot_joint_leg6>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </hexapod_isaacsim/Geometry/base_link>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg1>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg1/femur_leg1>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg1/femur_leg1/tibia_leg1>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg1/femur_leg1/tibia_leg1/foot_leg1>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg2>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg2/femur_leg2>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg2/femur_leg2/tibia_leg2>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg2/femur_leg2/tibia_leg2/foot_leg2>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg3>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg3/femur_leg3>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg3/femur_leg3/tibia_leg3>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg3/femur_leg3/tibia_leg3/foot_leg3>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg4>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg4/femur_leg4>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg4/femur_leg4/tibia_leg4>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg4/femur_leg4/tibia_leg4/foot_leg4>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg5>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg5/femur_leg5>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg5/femur_leg5/tibia_leg5>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg5/femur_leg5/tibia_leg5/foot_leg5>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg6>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg6/femur_leg6>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg6/femur_leg6/tibia_leg6>,
        </hexapod_isaacsim/Geometry/base_link/coxa_leg6/femur_leg6/tibia_leg6/foot_leg6>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
