#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "base_link" (
        prepend references = @./geometries.usd@</Geometries/base_link>
    )
    {
        over "base_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_link/VisualMaterials/light_grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "light_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_grey>
            )
            {
            }
        }
    }

    def Xform "base_link_1" (
        prepend references = @./geometries.usd@</Geometries/base_link>
    )
    {
        over "base_link" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "coxa" (
        prepend references = @./geometries.usd@</Geometries/coxa>
    )
    {
        over "coxa" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/coxa/VisualMaterials/light_grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "light_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_grey>
            )
            {
            }
        }
    }

    def Xform "coxa_1" (
        prepend references = @./geometries.usd@</Geometries/coxa>
    )
    {
        over "coxa" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "femur" (
        prepend references = @./geometries.usd@</Geometries/femur>
    )
    {
        over "femur" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/femur/VisualMaterials/black>
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }
        }
    }

    def Xform "femur_1" (
        prepend references = @./geometries.usd@</Geometries/femur>
    )
    {
        over "femur" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

    def Xform "tibia" (
        prepend references = @./geometries.usd@</Geometries/tibia>
    )
    {
        over "tibia" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/tibia/VisualMaterials/red>
        }

        def Scope "VisualMaterials"
        {
            def Material "red" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/red>
            )
            {
            }
        }
    }

    def Xform "tibia_1" (
        prepend references = @./geometries.usd@</Geometries/tibia>
    )
    {
        over "tibia" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }
}

